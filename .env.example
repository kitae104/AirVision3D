# AirVision 3D 환경변수 예시
# 이 파일을 .env로 복사한 뒤 값을 채워서 사용한다. (.env는 커밋 금지)
# ★ 원격 PostgreSQL 접속 정보는 아래 Database 섹션에 입력한다.

# === Database (원격 PostgreSQL + PostGIS) ===
# 원격 DB 서버 주소/포트/DB명/계정 정보를 입력한다.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=airvision
POSTGRES_USER=airvision
POSTGRES_PASSWORD=change-me

# === Backend (Spring Boot) ===
BACKEND_PORT=8080
# JWT 서명 키 (운영 시 반드시 무작위 값으로 교체, 최소 32바이트)
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
# 최초 기동 시 생성되는 기본 계정 비밀번호 (미설정 시 admin1234! / user1234!)
ADMIN_INIT_PASSWORD=
USER_INIT_PASSWORD=
AI_SERVICE_URL=http://localhost:8000

# === 공공데이터포털 (AirKorea / 기상청) ===
# 공공데이터포털(data.go.kr)에서 발급받은 "디코딩(원본)" 일반 인증키를 입력한다.
# 키가 비어 있으면 PUBLIC_DATA_MOCK_ENABLED=auto에 의해 내장 Mock 데이터로 동작한다.
AIRKOREA_SERVICE_KEY=your_airkorea_service_key
KMA_SERVICE_KEY=your_kma_service_key
# 기본값 사용 권장 (공식 서비스 URL이 바뀐 경우에만 변경)
AIRKOREA_BASE_URL=https://apis.data.go.kr/B552584
KMA_BASE_URL=https://apis.data.go.kr/1360000
# 실시간/지도 기본 시도명 (서울, 인천, 경기 등)
AIRKOREA_DEFAULT_SIDO=인천
# Mock 모드: auto(키 없으면 Mock) | true(항상 Mock) | false(항상 실 API)
PUBLIC_DATA_MOCK_ENABLED=auto
# 캐시 TTL(초): 실시간 대기질 / 기상
AIR_QUALITY_CACHE_TTL=1800
WEATHER_CACHE_TTL=1800
# AI 추정-실측 비교 매칭 허용 범위
COMPARISON_MAX_DISTANCE_KM=5
COMPARISON_MAX_MINUTES=60

# === AI Service (FastAPI) ===
AI_SERVICE_PORT=8000
# 데이터/모델 저장 루트
DATA_DIR=./data

# === Frontend (React + Vite) ===
FRONTEND_PORT=5173
# 브라우저에서 접근하는 백엔드 주소
VITE_API_BASE_URL=http://localhost:8080/api
# 브라우저에서 접근하는 AI 서비스 주소 (헬스체크 표시용)
VITE_AI_SERVICE_URL=http://localhost:8000
# Cesium ion 토큰 (없으면 비워둠 - OSM imagery 폴백)
VITE_CESIUM_ION_TOKEN=
